---
// src/components/WaitlistForm.astro
const { placeholder = "your@email.com", buttonText = "Rezervă Acces Prioritar" } = Astro.props;
---
<div id="waitlist" class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 max-w-md mx-auto mb-16 shadow-2xl shadow-emerald-500/10">
  <form name="waitlist-majordom" method="POST" data-netlify="true" class="flex flex-col gap-4">
    <input type="hidden" name="form-name" value="waitlist-majordom"/>
    <input
      type="email"
      name="email"
      placeholder={placeholder}
      required
      class="w-full px-4 py-4 rounded-lg bg-white/10 border border-white/20 text-white focus:border-emerald-400 transition-all outline-none"
    />
    <button type="submit" class="w-full px-6 py-4 rounded-lg bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-bold text-lg hover:scale-105 transition-all shadow-lg shadow-emerald-500/20">
      {buttonText}
    </button>
  </form>
</div>
