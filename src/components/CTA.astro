---
// src/components/CTA.astro
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
import WaitlistForm from './WaitlistForm.astro';
---
<section class="py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="backdrop-blur-xl bg-white/5 border border-white/20 rounded-2xl p-12 text-center">
      <h2 class="heading-xl mb-6">
        <span class="text-gradient-sovereign">{title}</span>
      </h2>
      <p class="text-subtitle max-w-2xl mx-auto mb-10">
        {subtitle}
      </p>
      <WaitlistForm />
    </div>
  </div>
</section>
