---
// src/components/MediaVault.astro
interface Props {
  title: string;
  highlight: string;
  description: string;
  features: string[];
}

const { title, highlight, description, features } = Astro.props;
---
<section class="px-6 py-20 bg-gradient-to-b from-transparent via-purple-500/5 to-transparent border-b border-white/10">
    <div class="max-w-5xl mx-auto">
        <div class="backdrop-blur-xl bg-white/5 border border-white/20 rounded-2xl p-12 flex flex-col md:flex-row items-center gap-12">
            <div class="flex-1">
                <div class="text-6xl mb-6">🎬</div>
                <h2 class="text-4xl font-bold mb-4">
                    {title} <span class="bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">{highlight}</span>
                </h2>
                <p class="text-subtitle mb-6">{description}</p>
                <ul class="space-y-3 text-gray-400">
                    {features.map(f => (
                        <li class="flex items-center gap-3">
                            <span class="text-purple-400 text-xl">✓</span> {f}
                        </li>
                    ))}
                </ul>
            </div>

            <slot name="visual-element" />
        </div>
    </div>
</section>
