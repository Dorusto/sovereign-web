---
const apps = [
    { name: "Immich", icon: "🖼️", desc: "Google Photos local", color: "emerald" },
    { name: "Vaultwarden", icon: "🔐", desc: "Manager parole", color: "blue" },
    { name: "Paperless-ngx", icon: "📄", desc: "Seif documente", color: "cyan" },
    { name: "Jellyfin", icon: "🎬", desc: "Netflix privat", color: "purple" }
];
---
<section class="px-6 py-20">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-4">Ecosistemul tău <span class="text-emerald-400">Complet</span></h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {apps.map(app => (
                <div class={`backdrop-blur-xl bg-white/5 border border-white/20 rounded-xl p-6 hover:border-${app.color}-400/50 transition-all`}>
                    <div class="text-4xl mb-3">{app.icon}</div>
                    <h4 class="font-bold mb-2">{app.name}</h4>
                    <p class="text-sm text-gray-500">{app.desc}</p>
                </div>
            ))}
        </div>
    </div>
</section>
