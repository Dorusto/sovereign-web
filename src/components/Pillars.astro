---
// src/components/Pillars.astro
interface Pillar {
  icon: string;
  title: string;
  desc: string;
  color: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: Pillar[];
}

const { title, subtitle, items = [] } = Astro.props;
---
{console.log(items)}
<section class="px-6 py-20 md:py-28">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-4" set:html={title} />
            <p class="text-gray-400 text-lg max-w-2xl mx-auto">{subtitle}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {items.map(p => (
                <div class="group backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:bg-white/15 transition-all duration-300">
                    <div class="text-6xl mb-6">{p.icon}</div>
                    <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-emerald-400 transition-colors">{p.title}</h3>
                    <p class="text-gray-400 leading-relaxed italic">{p.desc}</p>
                </div>
            ))}
        </div>
    </div>
</section>
