---
import Layout from '../../layouts/Layout.astro'; // Două seturi de puncte
import Header from '../../components/Header.astro';
import HeroSection from '../../components/HeroSection.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import MasterCategories from '../../components/MasterCategories.astro';
import FinanceAI from '../../components/FinanceAI.astro';
import HomeAssistant from '../../components/HomeAssistant.astro';
import Nextcloud from '../../components/Nextcloud.astro';
import MediaVault from '../../components/MediaVault.astro';
import HealthAI from '../../components/HealthAI.astro';
import FAQ from '../../components/FAQ.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';

const pillarData = [
  { icon: "🥗", title: "AI Kitchen & Nutrition", desc: "Expiring food notifications and smart shopping lists.", color: "emerald" },
  { icon: "🧠", title: "Health & Clarity", desc: "Your local AI acts as a private wellness and fitness journal.", color: "blue" },
  { icon: "🏠", title: "Home Assistant", desc: "Automations and voice control processed 100% inside your home.", color: "cyan" }
];
---

<Layout title="Sovereign Life OS">
    <Header title="Sovereign Life OS" subtitle="Private. Local. Yours"/>

    <HeroSection
        titlePart1="Transform your home into the center"
        titlePart2="of your digital life"
        subtitle="Starting with the Financial Butler — the first step toward complete digital sovereignty. Your data stays at home, not on corporate servers."
    >
	<WaitlistForm
		slot="form-area"
		placeholder="your@email.com"
		buttonText="Reserve Priority Access"
	/>

</HeroSection>

<MasterCategories>
  <div slot="header">
    <h2 class="text-4xl md:text-6xl font-extrabold mb-6 italic tracking-tight text-white">
      Sovereign <span class="text-emerald-400">Life OS</span>
    </h2>
    <p class="text-xl text-gray-400 max-w-3xl mx-auto italic">
      "A complete architecture for the modern human who refuses to be a product."
    </p>
  </div>

  <div class="relative group p-8 rounded-3xl border border-blue-500/30 bg-gradient-to-br from-blue-600/20 to-cyan-500/10 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 flex flex-col opacity-70">
    <div class="absolute top-4 right-4 bg-gray-500/20 border border-gray-500/30 text-gray-400 text-xs font-bold px-3 py-1 rounded-full text-center uppercase tracking-wider">Coming Soon</div>
    <div class="text-5xl mb-6">🛡️</div>
    <h3 class="text-xs font-bold tracking-[0.2em] text-emerald-400 uppercase mb-2">Data Sovereignty</h3>
    <h4 class="text-2xl font-bold text-white mb-4">Digital Pillar: FOUNDATION</h4>
    <p class="text-gray-300 mb-6 leading-relaxed">The foundation upon which you rebuild your freedom. Replace corporate infrastructure with your own digital bunker.</p>
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Private Cloud (Docs/Photos)</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Identity Vault (Passwords/2FA)</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Private 4K Media Streaming</div>
    </div>
    <div class="pt-6 border-t border-white/10 mt-auto">
      <p class="text-xs text-gray-500 italic">Replaces: Google One, iCloud, Dropbox, OneDrive, LastPass.</p>
    </div>
  </div>

  <div class="relative group p-8 rounded-3xl border border-emerald-500/30 bg-gradient-to-br from-emerald-600/20 to-lime-500/10 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 flex flex-col opacity-70">
    <div class="absolute top-4 right-4 bg-gray-500/20 border border-gray-500/30 text-gray-400 text-xs font-bold px-3 py-1 rounded-full text-center uppercase tracking-wider">Coming Soon</div>
    <div class="text-5xl mb-6">🧠</div>
    <h3 class="text-xs font-bold tracking-[0.2em] text-emerald-400 uppercase mb-2">Intelligence & Wellness</h3>
    <h4 class="text-2xl font-bold text-white mb-4">Vital Pillar: MENTOR</h4>
    <p class="text-gray-300 mb-6 leading-relaxed">Your physical and mental evolution guided by an AI that knows your biometrics but respects your privacy.</p>
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>AI Health & Fitness Coach</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Nutrition & Fridge Inventory</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Local Biometric Analysis</div>
    </div>
    <div class="pt-6 border-t border-white/10 mt-auto">
      <p class="text-xs text-gray-500 italic">Replaces: MyFitnessPal, Strava, AI Coaches, Medical Journals.</p>
    </div>
  </div>

  <div class="relative group p-8 rounded-3xl border border-yellow-500/30 bg-gradient-to-br from-yellow-600/20 to-orange-500/10 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 flex flex-col">
    <div class="absolute top-4 right-4 bg-yellow-500/20 border border-yellow-500/40 text-yellow-400 text-xs font-bold px-3 py-1 rounded-full text-center uppercase tracking-wider">In Development</div>
    <div class="text-5xl mb-6">🏛️</div>
    <h3 class="text-xs font-bold tracking-[0.2em] text-emerald-400 uppercase mb-2">Prosperity & Autonomy</h3>
    <h4 class="text-2xl font-bold text-white mb-4">Strategic Pillar: ARCHITECT</h4>
    <p class="text-gray-300 mb-6 leading-relaxed">The brain that optimizes your home resources and your portfolio. The only pillar that generates both money and time.</p>
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Sovereign Finance (Budget/Investments)</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Home & Energy Control</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Automated Shopping</div>
    </div>
    <div class="pt-6 border-t border-white/10 mt-auto">
      <p class="text-xs text-gray-500 italic">Replaces: YNAB, Alexa, Google Home, Financial Consultants.</p>
    </div>
  </div>

  <div slot="footer-stats">
    <h3 class="text-emerald-400 font-bold uppercase tracking-widest text-xs mb-4">The Impact of Sovereignty on Capital</h3>
    <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="text-left">
            <p class="text-3xl md:text-4xl font-bold text-white mb-2">Recover <span class="text-emerald-400">€1,500+</span> / year</p>
            <p class="text-gray-400 text-sm md:text-base">By consolidating the 3 pillars and stopping capital leaks to 15+ useless subscriptions.</p>
        </div>
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 relative overflow-hidden group">
            <p class="text-xs text-gray-500 uppercase mb-1 relative z-10">5-Year Projection</p>
            <p class="text-5xl font-black text-white italic relative z-10">€7,500</p>
            <p class="text-[10px] text-emerald-500/70 mt-2 font-medium relative z-10 uppercase tracking-tighter">Money that stays in your pocket</p>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-emerald-500/10 blur-2xl rounded-full"></div>
        </div>
    </div>
  </div>
</MasterCategories>

    <FinanceAI
    title="Sovereign Finance:"
    highlight="Clarity & Prosperity (Work in Progress)"
    description="The first and most important pillar. A financial brain that scans your invoices, optimizes your debt, and plans your future—without any bank or corporation knowing your net worth."
    features={[
        "Automatic receipt/invoice scanning via local AI",
        "Real-time budget monitoring (Cashflow vs. Expenses)",
        "Personalized debt elimination strategies (Snowball/Avalanche)",
        "Goal planner: 'Can I afford this trip?'",
        "Portfolio analysis and investment simulations",
        "Legal digital archive: Organized and searchable invoices"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-yellow-600/20 to-emerald-600/20 border border-yellow-500/30 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Replaces</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">YNAB (You Need A Budget)</p>
                <p class="text-gray-300 line-through opacity-50">Receipt Bank / Expensify</p>
                <p class="text-gray-300 line-through opacity-50">Complicated Spreadsheets</p>
                <p class="text-gray-300 line-through opacity-50">Management Fees</p>
            </div>
            <div class="pt-4 border-t border-white/10">
                <p class="text-yellow-400 font-bold text-xl">Financial Sovereignty</p>
            </div>
        </div>
    </div>
</FinanceAI>

<HomeAssistant
    title="Home Assistant:"
    highlight="Your Home's Brain"
    description="Total control over your smart devices without sending data to Amazon, Google, or Apple. Automations that work even without an internet connection."
    features={[
        "Local control for lights, sensors, and plugs",
        "Complex automations based on your presence",
        "Customizable interface for tablet or phone",
        "Integration with over 2000 hardware brands"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-orange-500/20 to-red-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Replaces</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">Amazon Alexa</p>
                <p class="text-gray-300 line-through opacity-50">Google Home</p>
                <p class="text-gray-300 line-through opacity-50">Apple HomeKit (Cloud)</p>
                <p class="text-gray-300 line-through opacity-50">Samsung SmartThings</p>
            </div>
            <p class="text-orange-400 font-bold text-xl">100% Local Privacy</p>
        </div>
    </div>
</HomeAssistant>

    <Nextcloud
        title="Nextcloud:"
        highlight="Your Private Office"
        description="The complete alternative to Google Cloud/Drive. Documents, Calendars, and Contacts synced across all your devices, without corporate access."
        features={["Automatic sync across all devices",
        "Real-time collaboration",
        "Private calendar and contacts",
        "Automatic encrypted backup"]}
    >
        <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/20 to-blue-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Replaces:</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">Google Drive & Photos</p>
                <p class="text-gray-300 line-through opacity-50">Microsoft Office 365</p>
                <p class="text-gray-300 line-through opacity-50">Dropbox & Box</p>
                <p class="text-gray-300 line-through opacity-50">Evernote & Slack</p>
                <p class="text-gray-300 line-through opacity-50">iCloud / Apple One</p>
            </div>
            <p class="text-emerald-400 font-bold text-lg">With a single solution</p>
        </div>
    </div>
    </Nextcloud>

<MediaVault
    title="Digital Vault:"
    highlight="Memories & Media"
    description="Transform your collection of movies, music, and photos into a personal streaming service. Original 4K quality, no compression, and no monthly fees."
    features={[
        "4K streaming without buffering on local network",
        "Automatic photo backup from phone (Immich)",
        "Facial recognition and local AI organization",
        "Access your music and audiobook library anywhere"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-purple-500/20 to-pink-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Replaces</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">Netflix & Disney+</p>
                <p class="text-gray-300 line-through opacity-50">Google Photos (Paid)</p>
                <p class="text-gray-300 line-through opacity-50">Spotify & Audible</p>
                <p class="text-gray-300 line-through opacity-50">iCloud Storage</p>
            </div>
            <p class="text-purple-400 font-bold text-xl">Your Own Cinema</p>
        </div>
    </div>
</MediaVault>

<HealthAI
    title="Sovereign:"
    highlight="Health & Vitality"
    description="More than just a database, it's your personal coach that doesn't judge you or sell your data. An integrated system that understands the link between how you move and what you eat."
    features={[
        "AI Running Coach: heart-rate based plans",
        "Locally generated fitness programs (Age/Weight/Sex)",
        "Auto-correlation: Training vs. Nutrients consumed",
        "Sleep quality analysis and recovery recommendations",
        "100% Privacy: Your biometric data stays in your house",
        "No monthly fees for 'premium features'"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/20 to-blue-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Replaces</p>
            <div class="space-y-3 mb-6 text-sm">
                <p class="text-gray-300 line-through opacity-50">Strava & Runkeeper Premium</p>
                <p class="text-gray-300 line-through opacity-50">Freeletics & MyFitnessPal</p>
                <p class="text-gray-300 line-through opacity-50">Whoop / Oura Subscription</p>
                <p class="text-gray-300 line-through opacity-50">Apple Fitness+</p>
            </div>
            <div class="pt-4 border-t border-white/10">
                <p class="text-blue-400 font-bold text-lg">Performance without Surveillance</p>
            </div>
        </div>
    </div>
</HealthAI>

<section class="py-24 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-red-500/10 blur-[120px] rounded-full -z-10"></div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">The Great <span class="text-red-500">Purge</span></h2>
            <p class="text-gray-400 text-lg max-w-2xl mx-auto">
                Sovereign Life OS isn't another fee. It's the tool that eliminates all the others.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {[
                "Netflix", "Spotify", "iCloud", "Google One",
                "YNAB", "Strava", "Dropbox", "Evernote",
                "Zapier", "Notion", "LastPass", "MyFitnessPal",
                "Amazon Alexa", "Life360", "Microsoft 365", "Audible",
                "Disney+", "Zoom", "Slack", "WeTransfer Pro",
                "OneDrive", "Apple Music", "HBO Max", "Bitwarden Cloud"
            ].map((service) => (
                <div class="group relative bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-center transition-all duration-500 hover:bg-red-500/10 hover:border-red-500/30">
                    <span class="text-gray-500 font-medium group-hover:text-red-400 transition-colors">
                        {service}
                    </span>
                    <div class="absolute w-0 h-[2px] bg-red-500 left-0 top-1/2 -translate-y-1/2 transition-all duration-500 group-hover:w-full opacity-0 group-hover:opacity-100 shadow-[0_0_10px_rgba(239,68,68,0.5)]"></div>
                </div>
            ))}
        </div>

        <div class="mt-16 p-8 bg-gradient-to-r from-red-500/10 to-transparent border-l-4 border-red-500 rounded-r-2xl">
            <p class="text-white text-xl md:text-2xl font-light italic">
                "We calculated that the average user saves between <span class="text-red-400 font-bold">€1,200 and €2,500 per year</span> by simply consolidating these services into their own system."
            </p>
        </div>
    </div>
</section>

<FAQ>
        <div slot="title">
            <h2 class="text-3xl md:text-5xl font-bold mb-4">Frequently Asked <span class="text-emerald-400">Questions</span></h2>
            <p class="text-gray-400 italic">Everything you need to know about your new digital sovereignty.</p>
        </div>

        <FAQItem
            colorClass="emerald"
            question="Where is my data physically stored?"
            answer="On a server (Mini PC or NAS) located in your home. No intermediate 'cloud', no foreign servers, and no unauthorized access. You own the hardware, you own the data."
        />

        <FAQItem
            colorClass="blue"
            question="What happens if the internet goes down?"
            answer="The system works perfectly offline. You can control your home, watch movies from your library, or access documents. Sovereignty means not depending on an external connection for basic life functions."
        />

        <FAQItem
            colorClass="red"
            question="What if the hard drive fails or the server is stolen?"
            answer="The system uses AES-256 encryption (without your key, data is unreadable) and a '3-2-1' backup strategy: data is mirrored on redundant disks and backed up encrypted to a second location."
        />

        <FAQItem
            colorClass="orange"
            question="Is the local AI as smart as ChatGPT?"
            answer="We use state-of-the-art LLMs optimized for your hardware. They are highly capable in financial analysis, nutrition, and automation tasks—all with zero latency and total privacy."
        />

        <FAQItem
            colorClass="purple"
            question="Can I access my data when I'm not at home?"
            answer="Yes. We use technologies like Tailscale to create a private digital bunker between your devices. You connect to your home server from anywhere in the world securely and quickly."
        />

        <FAQItem
            colorClass="yellow"
            question="Can I import my old data from Google or Apple?"
            answer="Yes. The system includes migration tools for Google Photos, Drive, and iCloud. You can transfer your entire digital history and cancel your subscriptions without losing anything."
        />

        <FAQItem
            colorClass="blue"
            question="How much power does this server consume?"
            answer="Our servers are ultra-efficient, consuming about as much as an LED bulb (10-15W). The annual cost is negligible compared to the hundreds of euros saved by eliminating subscriptions."
        />

        <FAQItem
            colorClass="emerald"
            question="Do I need to be a programmer to use it?"
            answer="Not at all. Sovereign Life OS has an intuitive visual interface. Once configured, it's a 'set and forget' system with automatic updates and a simple dashboard."
        />

        <FAQItem
            colorClass="purple"
            question="Is it a one-time investment or are there hidden costs?"
            answer="It is a one-time investment in your freedom. No monthly fees or features locked behind a paywall. The software and data belong to you for life."
        />

        <FAQItem
            colorClass="orange"
            question="How does the Strategic (Finance) pillar help me make money?"
            answer="The AI analyzes capital leaks, optimizes debt interest, and offers investment strategies. You don't just save on subscriptions; you learn to manage your wealth more efficiently."
        />
    </FAQ>

    <WaitlistForm
    slot="form-area"
    placeholder="your@email.com"
    buttonText="Reserve Priority Access"
/>

<CTA
    title="Ready to take your life back?"
    subtitle="Join the digital sovereignty revolution today."
    buttonText="Reserve Priority Access"
/>

    <Footer>
        <div slot="brand">
            <h3 class="text-white font-bold text-xl mb-4">Sovereign Life OS</h3>
            <p class="text-gray-400">Transform your home into a private, smart ecosystem.</p>
        </div>

        <div slot="links">
            <h4 class="text-white font-bold mb-4">Links</h4>
            <ul class="text-gray-400 space-y-2">
                <li><a href="#" class="hover:text-emerald-400 transition-colors">Documentation</a></li>
                <li><a href="#" class="hover:text-emerald-400 transition-colors">GitHub</a></li>
                <li><a href="#" class="hover:text-emerald-400 transition-colors">Privacy Policy</a></li>
            </ul>
        </div>

        <div slot="privacy">
            <h4 class="text-white font-bold mb-4">Privacy First</h4>
            <p class="text-gray-400 italic text-sm">Your data never leaves your local network. No tracking. No cloud. No compromise.</p>
        </div>

        <p slot="copyright">© 2026 Sovereign Life OS. All rights reserved.</p>
    </Footer>

</Layout>
