---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sovereign Life OS - Your Private Digital Butler">
	<div class="min-h-screen flex flex-col">
		<!-- Navigation -->
		<nav class="backdrop-blur-md bg-white/5 border-b border-white/10 sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
				<div class="text-2xl font-bold bg-gradient-to-r from-emerald-400 to-blue-500 bg-clip-text text-transparent">
					Sovereign Life OS
				</div>
				<div class="text-sm text-gray-400">Private. Local. Yours.</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative px-6 py-24 md:py-32 overflow-hidden">
			<!-- Animated background gradient -->
			<div class="absolute inset-0 -z-10">
				<div class="absolute top-0 left-1/4 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl"></div>
				<div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
			</div>

			<div class="max-w-5xl mx-auto text-center">
				<!-- Main Title -->
				<h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
					<span class="bg-gradient-to-r from-emerald-300 via-emerald-400 to-blue-500 bg-clip-text text-transparent">
						Majordomul Digital
					</span>
					<br />
					<span class="text-white">care nu te spionează</span>
				</h1>

				<!-- Subtitle -->
				<p class="text-lg md:text-xl text-gray-300 mb-12 leading-relaxed max-w-3xl mx-auto">
					Înlocuiește Google, Alexa și abonamentele scumpe cu un singur creier central, local.
					<span class="block mt-3 text-emerald-400 font-semibold text-lg">Sănătatea, finanțele și casa ta, sub controlul tău total.</span>
				</p>

				<!-- Waitlist Form - Prominent -->
				<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 max-w-md mx-auto mb-16 shadow-2xl shadow-emerald-500/10">
					<form id="waitlistForm" name="waitlist-majordom" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" class="flex flex-col gap-4">
						<input type="hidden" name="form-name" value="waitlist-majordom"/>
						<p class="hidden">
							<label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
						</p>
						<div class="relative">
							<input type="email"	name="email" placeholder="your@email.com" required class="w-full px-4 py-4 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 transition-all"/>
						</div>
						<button	type="submit" class="w-full px-6 py-4 rounded-lg bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-bold text-lg transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/60 hover:scale-105 active:scale-95 transform">
							Rezervă Acces Prioritar
						</button>
					</form>
				</div>

				<!-- Trust badges -->
				<div class="flex flex-wrap justify-center gap-6 text-sm text-gray-400">
					<div class="flex items-center gap-2">
						<span class="text-emerald-400">✓</span> Open Source
					</div>
					<div class="flex items-center gap-2">
						<span class="text-emerald-400">✓</span> Self-Hosted
					</div>
					<div class="flex items-center gap-2">
						<span class="text-emerald-400">✓</span> Privacy First
					</div>
				</div>
			</div>
		</section>

		<!-- Your Ecosystem Without Subscriptions - Savings Calculator -->
		<section class="px-6 py-20 md:py-28 bg-gradient-to-b from-transparent via-white/5 to-transparent">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold mb-4">
						Ecosistemul tău
						<span class="bg-gradient-to-r from-emerald-400 to-blue-500 bg-clip-text text-transparent">
							Fără Chirii
						</span>
					</h2>
					<p class="text-gray-400 text-lg max-w-2xl mx-auto">
						Compară costurile: serviciile cloud vs. soluția ta locală
					</p>
				</div>

				<!-- Savings Comparison Grid -->
				<div class="grid md:grid-cols-3 gap-6 mb-12">
					<!-- Cloud Storage -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-red-400/50 hover:bg-white/15 transition-all duration-300">
						<div class="flex items-center justify-between mb-4">
							<div>
								<p class="text-sm text-gray-400 mb-2">Cloud Storage</p>
								<p class="text-2xl font-bold text-red-400">❌ €120/an</p>
							</div>
							<div class="text-4xl">☁️</div>
						</div>
						<p class="text-gray-500 text-sm mb-4">Google One / iCloud (2TB)</p>
						<div class="border-t border-white/10 pt-4">
							<p class="text-sm text-gray-400 mb-2">Soluția ta:</p>
							<p class="text-2xl font-bold text-emerald-400">✅ €0</p>
							<p class="text-gray-500 text-sm">Nextcloud & Immich</p>
						</div>
					</div>

					<!-- Password Manager -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-red-400/50 hover:bg-white/15 transition-all duration-300">
						<div class="flex items-center justify-between mb-4">
							<div>
								<p class="text-sm text-gray-400 mb-2">Password Manager</p>
								<p class="text-2xl font-bold text-red-400">❌ €36/an</p>
							</div>
							<div class="text-4xl">🔐</div>
						</div>
						<p class="text-gray-500 text-sm mb-4">1Password / LastPass</p>
						<div class="border-t border-white/10 pt-4">
							<p class="text-sm text-gray-400 mb-2">Soluția ta:</p>
							<p class="text-2xl font-bold text-emerald-400">✅ €0</p>
							<p class="text-gray-500 text-sm">Vaultwarden</p>
						</div>
					</div>

					<!-- Health & Fitness Apps -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-red-400/50 hover:bg-white/15 transition-all duration-300">
						<div class="flex items-center justify-between mb-4">
							<div>
								<p class="text-sm text-gray-400 mb-2">Health & Fitness</p>
								<p class="text-2xl font-bold text-red-400">❌ €150/an</p>
							</div>
							<div class="text-4xl">💪</div>
						</div>
						<p class="text-gray-500 text-sm mb-4">Fitness & Mental Health Apps</p>
						<div class="border-t border-white/10 pt-4">
							<p class="text-sm text-gray-400 mb-2">Soluția ta:</p>
							<p class="text-2xl font-bold text-emerald-400">✅ €0</p>
							<p class="text-gray-500 text-sm">AI Health Coach</p>
						</div>
					</div>
				</div>

				<!-- Total Savings -->
				<div class="backdrop-blur-xl bg-gradient-to-r from-emerald-500/20 to-blue-500/20 border border-emerald-400/50 rounded-2xl p-8 text-center">
					<p class="text-gray-300 text-lg mb-2">Total Economisit Anual</p>
					<p class="text-5xl md:text-6xl font-bold bg-gradient-to-r from-emerald-400 to-blue-500 bg-clip-text text-transparent mb-4">
						Peste €300/an
					</p>
					<p class="text-emerald-400 font-semibold text-lg">
						Sistemul se plătește singur în 2 ani. După aceea, doar economii.
					</p>
				</div>
			</div>
		</section>

		<!-- The 3 Pillars of Intelligence - Updated -->
		<section class="px-6 py-20 md:py-28">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold mb-4">
						Cei 3 Piloni de
						<span class="bg-gradient-to-r from-emerald-400 to-blue-500 bg-clip-text text-transparent">
							Inteligență
						</span>
					</h2>
					<p class="text-gray-400 text-lg max-w-2xl mx-auto">
						Trei agenți AI care lucrează local pentru a-ți simplifica viața
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<!-- Pillar 1: Kitchen & Nutrition -->
					<div class="group backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-emerald-400/50 hover:bg-white/15 transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/20">
						<div class="text-6xl mb-6">🥗</div>
						<h3 class="text-2xl font-bold mb-4 text-emerald-400 group-hover:text-emerald-300 transition-colors">
							AI Kitchen & Nutrition
						</h3>
						<p class="text-gray-400 leading-relaxed italic">
							Notificări înainte de expirarea alimentelor și liste de cumpărături inteligente. Reduci risipa, economisești bani.
						</p>
					</div>

					<!-- Pillar 2: Mental & Physical Health -->
					<div class="group backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-blue-400/50 hover:bg-white/15 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/20">
						<div class="text-6xl mb-6">🧠</div>
						<h3 class="text-2xl font-bold mb-4 text-blue-400 group-hover:text-blue-300 transition-colors">
							Sănătate & Claritate Mentală
						</h3>
						<p class="text-gray-400 leading-relaxed italic">
							AI-ul tău local acționează ca un jurnal privat de wellness. Corelează starea de spirit cu activitățile zilnice și oferă planuri de fitness personalizate, fără ca nicio secundă din viața ta privată să ajungă în Cloud.
						</p>
					</div>

					<!-- Pillar 3: Home Assistant -->
					<div class="group backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-cyan-400/50 hover:bg-white/15 transition-all duration-300 hover:shadow-xl hover:shadow-cyan-500/20">
						<div class="text-6xl mb-6">🏠</div>
						<h3 class="text-2xl font-bold mb-4 text-cyan-400 group-hover:text-cyan-300 transition-colors">
							Home Assistant (Control Local)
						</h3>
						<p class="text-gray-400 leading-relaxed italic">
							Spune adio boxelor Google/Alexa care te ascultă. Automatizări și control vocal procesate 100% în casa ta.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Nextcloud: Your Private Office -->
		<section class="px-6 py-20 md:py-28 bg-gradient-to-r from-blue-500/10 via-transparent to-emerald-500/10 border-y border-white/10">
			<div class="max-w-5xl mx-auto">
				<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-12">
					<div class="flex flex-col md:flex-row items-center gap-8">
						<div class="flex-1">
							<div class="text-6xl mb-6">☁️</div>
							<h2 class="text-4xl md:text-5xl font-bold mb-4">
								Nextcloud:
								<span class="bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent">
									Biroul tău Privat
								</span>
							</h2>
							<p class="text-gray-300 text-lg leading-relaxed mb-6">
								Alternativa completă la Google Cloud/Drive. Documente, Calendar și Contacte sincronizate pe toate dispozitivele tale, fără ca o corporație să aibă acces la ele.
							</p>
							<ul class="space-y-3 text-gray-400">
								<li class="flex items-center gap-3">
									<span class="text-emerald-400 text-xl">✓</span> Sincronizare automată pe toate dispozitivele
								</li>
								<li class="flex items-center gap-3">
									<span class="text-emerald-400 text-xl">✓</span> Colaborare în timp real pe documente
								</li>
								<li class="flex items-center gap-3">
									<span class="text-emerald-400 text-xl">✓</span> Calendar și contacte private
								</li>
								<li class="flex items-center gap-3">
									<span class="text-emerald-400 text-xl">✓</span> Backup automat și versionare
								</li>
							</ul>
						</div>
						<div class="flex-1 hidden md:block">
							<div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/20 to-blue-500/20 border border-white/20 rounded-xl p-8 text-center">
								<p class="text-gray-400 mb-4">Înlocuiește</p>
								<div class="space-y-3 mb-6">
									<p class="text-gray-300 line-through">Google Drive</p>
									<p class="text-gray-300 line-through">Microsoft OneDrive</p>
									<p class="text-gray-300 line-through">Dropbox</p>
									<p class="text-gray-300 line-through">iCloud</p>
								</div>
								<p class="text-emerald-400 font-bold text-lg">Cu o singură soluție</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Your Private Ecosystem -->
		<section class="px-6 py-20 md:py-28">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold mb-4">
						Ecosistemul tău
						<span class="bg-gradient-to-r from-emerald-400 to-blue-500 bg-clip-text text-transparent">
							Complet
						</span>
					</h2>
					<p class="text-gray-400 text-lg max-w-2xl mx-auto">
						Aplicații open-source care lucrează în armonie pe serverul tău
					</p>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
					<!-- Immich -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-xl p-6 hover:border-emerald-400/50 hover:bg-white/15 transition-all duration-300 group cursor-pointer">
						<div class="text-4xl mb-3">🖼️</div>
						<h4 class="font-bold text-white mb-2 group-hover:text-emerald-400 transition-colors">Immich</h4>
						<p class="text-sm text-gray-500">Alternativa privată la Google Photos</p>
					</div>

					<!-- Vaultwarden -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-xl p-6 hover:border-blue-400/50 hover:bg-white/15 transition-all duration-300 group cursor-pointer">
						<div class="text-4xl mb-3">🔐</div>
						<h4 class="font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">Vaultwarden</h4>
						<p class="text-sm text-gray-500">Manager de parole self-hosted</p>
					</div>

					<!-- Paperless-ngx -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-xl p-6 hover:border-cyan-400/50 hover:bg-white/15 transition-all duration-300 group cursor-pointer">
						<div class="text-4xl mb-3">📄</div>
						<h4 class="font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Paperless-ngx</h4>
						<p class="text-sm text-gray-500">Seiful tău digital pentru documente</p>
					</div>

					<!-- Jellyfin -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-xl p-6 hover:border-purple-400/50 hover:bg-white/15 transition-all duration-300 group cursor-pointer">
						<div class="text-4xl mb-3">🎬</div>
						<h4 class="font-bold text-white mb-2 group-hover:text-purple-400 transition-colors">Jellyfin</h4>
						<p class="text-sm text-gray-500">Netflix-ul tău privat</p>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ Sovereign -->
		<section class="px-6 py-20 md:py-28 bg-gradient-to-b from-transparent via-white/5 to-transparent">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold mb-4">
						Întrebări
						<span class="bg-gradient-to-r from-emerald-400 to-blue-500 bg-clip-text text-transparent">
							Frecvente
						</span>
					</h2>
					<p class="text-gray-400 text-lg">Răspunsuri rapide la întrebările tale</p>
				</div>

				<div class="grid md:grid-cols-2 gap-6">
					<!-- FAQ 1 -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-emerald-400/50 hover:bg-white/15 transition-all duration-300">
						<h3 class="text-xl font-bold text-emerald-400 mb-3">
							Ce se întâmplă dacă pică internetul?
						</h3>
						<p class="text-gray-400 leading-relaxed">
							Totul continuă să funcționeze. Casa ta rămâne inteligentă, AI-ul rămâne activ. Doar sincronizarea cu alte dispozitive se întârzie până la revenirea conexiunii.
						</p>
					</div>

					<!-- FAQ 2 -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-blue-400/50 hover:bg-white/15 transition-all duration-300">
						<h3 class="text-xl font-bold text-blue-400 mb-3">
							Unde sunt datele?
						</h3>
						<p class="text-gray-400 leading-relaxed">
							Pe hard-disk-ul din sufrageria ta. Punct. Nicio companie nu are acces la ele. Tu ești singurul proprietar.
						</p>
					</div>

					<!-- FAQ 3 -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-cyan-400/50 hover:bg-white/15 transition-all duration-300">
						<h3 class="text-xl font-bold text-cyan-400 mb-3">
							Cât de greu este să instalez?
						</h3>
						<p class="text-gray-400 leading-relaxed">
							Am creat ghiduri pas-cu-pas pentru fiecare nivel de abilitate. Chiar și pentru începători. Suportul comunității este mereu disponibil.
						</p>
					</div>

					<!-- FAQ 4 -->
					<div class="backdrop-blur-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-2xl p-8 hover:border-purple-400/50 hover:bg-white/15 transition-all duration-300">
						<h3 class="text-xl font-bold text-purple-400 mb-3">
							Ce hardware am nevoie?
						</h3>
						<p class="text-gray-400 leading-relaxed">
							Un server modest (Raspberry Pi, NAS, sau PC vechi). Investiția inițială: ~500€. După aceea, doar costuri de electricitate.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="px-6 py-16 md:py-20">
			<div class="max-w-3xl mx-auto text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-6">
					Gata să-ți iei viața înapoi?
				</h2>
				<p class="text-gray-400 text-lg mb-8">
					Fii printre primii care vor accesa Sovereign Life OS. Locuri limitate pentru beta testers.
				</p>
				<button
					onclick="document.getElementById('waitlistForm').scrollIntoView({ behavior: 'smooth' })"
					class="px-8 py-4 rounded-lg bg-gradient-to-r from-emerald-500 to-blue-600 hover:from-emerald-400 hover:to-blue-500 text-white font-bold text-lg transition-all duration-300 hover:shadow-lg hover:shadow-emerald-500/50 active:scale-95"
				>
					Rezervă Acces Prioritar
				</button>
				<p class="text-gray-500 text-sm mt-4">
					Alătură-te celor 500+ oameni care au ales suveranitatea digitală.
				</p>
			</div>
		</section>

		<!-- Footer -->
		<footer class="backdrop-blur-md bg-white/5 border-t border-white/10 py-12 mt-auto">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid md:grid-cols-3 gap-8 mb-8">
					<div>
						<h4 class="font-bold text-white mb-4">Sovereign Life OS</h4>
						<p class="text-gray-500 text-sm">
							Transformă-ți casa într-un ecosistem inteligent și privat.
						</p>
					</div>
					<div>
						<h4 class="font-bold text-white mb-4">Linkuri</h4>
						<ul class="space-y-2 text-sm text-gray-500 hover:text-gray-400 transition-colors">
							<li><a href="#" class="hover:text-emerald-400">Documentație</a></li>
							<li><a href="#" class="hover:text-emerald-400">GitHub</a></li>
							<li><a href="#" class="hover:text-emerald-400">Contact</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-bold text-white mb-4">Confidențialitate</h4>
						<p class="text-gray-500 text-sm">
							Datele tale nu sunt niciodată trimise în cloud. Totul rămâne local pe serverul tău.
						</p>
					</div>
				</div>

				<div class="border-t border-white/10 pt-8">
					<div class="flex flex-col md:flex-row justify-between items-center gap-4">
						<p class="text-gray-500 text-sm">
							© 2026 Sovereign Life OS. Toate drepturile rezervate.
						</p>
						<div class="flex gap-6 text-sm text-gray-500">
							<a href="#" class="hover:text-emerald-400 transition-colors">Privacy Policy</a>
							<a href="#" class="hover:text-emerald-400 transition-colors">Terms of Service</a>
						</div>
					</div>
				</div>

				<div class="mt-8 p-4 bg-white/5 border border-white/10 rounded-lg text-center">
					<p class="text-xs text-gray-500">
						<span class="text-emerald-400 font-semibold">Disclaimer:</span> Sovereign Life OS este în fază de dezvoltare. Datele tale sunt protejate prin criptare end-to-end și nu sunt niciodată transmise către servere externe.
					</p>
				</div>
			</div>
		</footer>
	</div>

</Layout>
