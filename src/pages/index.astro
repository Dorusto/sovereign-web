---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import MasterCategories from '../components/MasterCategories.astro';
import FinanceAI from '../components/FinanceAI.astro';
import HomeAssistant from '../components/HomeAssistant.astro';
import Nextcloud from '../components/Nextcloud.astro';
import MediaVault from '../components/MediaVault.astro';
import HealthAI from '../components/HealthAI.astro';
import FAQ from '../components/FAQ.astro'; // IMPORTI DOAR FAQ, NU FAQITEM
import FAQItem from '../components/FAQItem.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

// Putem defini datele în variabile aici sus pentru a păstra HTML-ul curat jos
const pillarData = [
  { icon: "🥗", title: "AI Kitchen & Nutrition", desc: "Notificări înainte de expirarea alimentelor și liste de cumpărături inteligente.", color: "emerald" },
  { icon: "🧠", title: "Sănătate & Claritate", desc: "AI-ul tău local acționează ca un jurnal privat de wellness și fitness.", color: "blue" },
  { icon: "🏠", title: "Home Assistant", desc: "Automatizări și control vocal procesate 100% în casa ta.", color: "cyan" }
];
---

<Layout title="Sovereign Life OS">
    <Header title="Sovereign Life OS" subtitle="Private. Local. Yours"/>

    <HeroSection
        titlePart1="Propriul tău Google,"
        titlePart2="fără Google"
        subtitle="Ai toate avantajele tehnologiei moderne (Cloud, AI, Smart Home), dar datele rămân în sufrageria ta, nu pe serverele corporațiilor. Recuperezi controlul și banii pierduți pe abonamente."
    >
        <WaitlistForm slot="form-area" />
    </HeroSection>

<MasterCategories>
  <div slot="header">
    <h2 class="heading-lg italic tracking-tight text-white">
      Sovereign <span class="text-gradient-sovereign">Life OS</span>
    </h2>
    <p class="text-subtitle max-w-3xl mx-auto">
      "O arhitectură completă pentru omul modern care refuză să mai fie un produs."
    </p>
  </div>

  <div class="relative group p-8 rounded-3xl border border-blue-500/30 bg-gradient-to-br from-blue-600/20 to-cyan-500/10 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 flex flex-col">
    <div class="text-5xl mb-6">🛡️</div>
    <h3 class="text-xs font-bold tracking-[0.2em] text-gradient-sovereign uppercase mb-2">Suveranitatea Datelor</h3>
    <h4 class="text-2xl font-bold text-white mb-4">Pilonul Digital: FOUNDATION</h4>
    <p class="text-gray-300 mb-6 leading-relaxed">Fundația pe care îți reconstruiești libertatea. Înlocuiește infrastructura corporațiilor cu propriul tău buncăr digital.</p>
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Cloud Privat (Documente/Foto)</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Seiful Identității (Parole/2FA)</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Streaming Media 4K Privat</div>
    </div>
    <div class="pt-6 border-t border-white/10 mt-auto">
      <p class="text-xs text-gray-500 italic">Înlocuiește: Google One, iCloud, Dropbox, OneDrive, LastPass.</p>
    </div>
  </div>

  <div class="relative group p-8 rounded-3xl border border-emerald-500/30 bg-gradient-to-br from-emerald-600/20 to-lime-500/10 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 flex flex-col">
    <div class="text-5xl mb-6">🧠</div>
    <h3 class="text-xs font-bold tracking-[0.2em] text-gradient-sovereign uppercase mb-2">Inteligență & Wellness</h3>
    <h4 class="text-2xl font-bold text-white mb-4">Pilonul Vital: MENTOR</h4>
    <p class="text-gray-300 mb-6 leading-relaxed">Evoluția ta fizică și mentală sub îndrumarea unui AI care îți cunoaște biometria, dar îți respectă intimitatea.</p>
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>AI Health & Fitness Coach</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Nutriție & Inventar Frigider</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Analiză Biometrică Locală</div>
    </div>
    <div class="pt-6 border-t border-white/10 mt-auto">
      <p class="text-xs text-gray-500 italic">Înlocuiește: MyFitnessPal, Strava, Coach-uri AI, Jurnale Medicale.</p>
    </div>
  </div>

  <div class="relative group p-8 rounded-3xl border border-yellow-500/30 bg-gradient-to-br from-yellow-600/20 to-orange-500/10 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 flex flex-col">
    <div class="text-5xl mb-6">🏛️</div>
    <h3 class="text-xs font-bold tracking-[0.2em] text-gradient-sovereign uppercase mb-2">Prosperitate & Autonomie</h3>
    <h4 class="text-2xl font-bold text-white mb-4">Pilonul Strategic: ARCHITECT</h4>
    <p class="text-gray-300 mb-6 leading-relaxed">Creierul care optimizează resursele casei și ale portofoliului tău. Singurul pilon care produce bani și timp.</p>
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Sovereign Finance (Buget/Investiții)</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Controlul Casei & Energiei</div>
      <div class="flex items-center gap-3 text-sm text-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Automatizarea Cumpărăturilor</div>
    </div>
    <div class="pt-6 border-t border-white/10 mt-auto">
      <p class="text-xs text-gray-500 italic">Înlocuiește: YNAB, Alexa, Google Home, Consultanți Financiari.</p>
    </div>
  </div>

  <div slot="footer-stats">
    <h3 class="text-gradient-sovereign font-bold uppercase tracking-widest text-xs mb-4">Impactul Suveranității asupra Capitalului</h3>
    <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="text-left">
            <p class="text-3xl md:text-4xl font-bold text-white mb-2">Recuperezi <span class="text-emerald-400">€1.500+</span> / an</p>
            <p class="text-gray-400 text-sm md:text-base">Prin consolidarea celor 3 piloni și oprirea scurgerilor de capital către 15+ abonamente inutile.</p>
        </div>
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 relative overflow-hidden group">
            <p class="text-xs text-gray-500 uppercase mb-1 relative z-10">Proiecție pe 5 ani</p>
            <p class="text-5xl font-black text-white italic relative z-10">€7.500</p>
            <p class="text-[10px] text-emerald-500/70 mt-2 font-medium relative z-10 uppercase tracking-tighter">Bani care rămân în buzunarul tău</p>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-emerald-500/10 blur-2xl rounded-full"></div>
        </div>
    </div>
  </div>
</MasterCategories>

    <FinanceAI
    title="Sovereign Finance:"
    highlight="Claritate & Prosperitate"
    description="Primul și cel mai important pilon. Un creier financiar care îți scanează facturile, îți optimizează datoriile și îți planifică viitorul, fără ca vreo bancă sau corporație să știe ce avere ai."
    features={[
        "Scanare automată bonuri/facturi și extragere date cu AI local",
        "Monitorizare buget în timp real (Cashflow vs. Cheltuieli)",
        "Strategii personalizate de eliminare a datoriilor (Snowball/Avalanche)",
        "Planificator de obiective: 'Îmi permit această excursie?'",
        "Analiză de portofoliu și simulări de investiții",
        "Arhivă digitală legală: Facturi organizate și ușor de găsit"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-yellow-600/20 to-emerald-600/20 border border-yellow-500/30 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Înlocuiește</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">YNAB (You Need A Budget)</p>
                <p class="text-gray-300 line-through opacity-50">Receipt Bank / Expensify</p>
                <p class="text-gray-300 line-through opacity-50">Spreadsheet-uri complicate</p>
                <p class="text-gray-300 line-through opacity-50">Comisioane de administrare</p>
            </div>
            <div class="pt-4 border-t border-white/10">
                <p class="text-yellow-400 font-bold text-xl">Suveranitate Financiară</p>
            </div>
        </div>
    </div>
</FinanceAI>

<HomeAssistant
    title="Home Assistant:"
    highlight="Creierul Casei Tale"
    description="Control total peste dispozitivele tale inteligente, fără să trimiți date la Amazon, Google sau Apple. Automatizări care funcționează chiar și fără internet."
    features={[
        "Control local pentru lumini, senzori și prize",
        "Automatizări complexe bazate pe prezența ta",
        "Interfață personalizabilă pe tabletă sau telefon",
        "Integrare cu peste 2000 de branduri de hardware"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-orange-500/20 to-red-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Înlocuiește</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">Amazon Alexa</p>
                <p class="text-gray-300 line-through opacity-50">Google Home</p>
                <p class="text-gray-300 line-through opacity-50">Apple HomeKit (Cloud)</p>
                <p class="text-gray-300 line-through opacity-50">Samsung SmartThings</p>
            </div>
            <p class="text-orange-400 font-bold text-xl">Privacy 100% Local</p>
        </div>
    </div>
</HomeAssistant>

<MediaVault
    title="Digital Vault:"
    highlight="Amintiri și Media"
    description="Transformă-ți colecția de filme, muzică și fotografii într-un serviciu de streaming personal. Calitate 4K originală, fără compresie și fără taxe lunare."
    features={[
        "Streaming 4K fără buffering în rețeaua locală",
        "Backup automat pentru pozele de pe telefon (Immich)",
        "Recunoaștere facială și organizare AI locală",
        "Acces la biblioteca de muzică și audiobook-uri oriunde"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-purple-500/20 to-pink-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Înlocuiește</p>
            <div class="space-y-3 mb-6">
                <p class="text-gray-300 line-through opacity-50">Netflix & Disney+</p>
                <p class="text-gray-300 line-through opacity-50">Google Photos (Abonament)</p>
                <p class="text-gray-300 line-through opacity-50">Spotify & Audible</p>
                <p class="text-gray-300 line-through opacity-50">iCloud Storage</p>
            </div>
            <p class="text-purple-400 font-bold text-xl">Propriul tău Cinema</p>
        </div>
    </div>
</MediaVault>

<HealthAI
    title="Sovereign:"
    highlight="Health & Vitality"
    description="Mai mult decât o bază de date, este antrenorul tău personal care nu te judecă și nu îți vinde datele. Un sistem integrat care înțelege legătura dintre cum te miști și ce mănânci."
    features={[
        "Antrenor vocal de alergare: planuri bazate pe ritmul tău cardiac",
        "Programe de fitness (vârstă/greutate/sex) generate local",
        "Corelare automată: antrenament vs. nutrienții consumați",
        "Analiza calității somnului și recomandări de recuperare",
        "Privacy 100%: Datele tale biometrice rămân în casa ta",
        "Fără abonamente lunare pentru 'funcții premium'"
    ]}
>
    <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/20 to-blue-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Înlocuiește</p>
            <div class="space-y-3 mb-6 text-sm">
                <p class="text-gray-300 line-through opacity-50">Strava & Runkeeper Premium</p>
                <p class="text-gray-300 line-through opacity-50">Freeletics & MyFitnessPal</p>
                <p class="text-gray-300 line-through opacity-50">Whoop / Oura Subscription</p>
                <p class="text-gray-300 line-through opacity-50">Apple Fitness+</p>
            </div>
            <div class="pt-4 border-t border-white/10">
                <p class="text-blue-400 font-bold text-lg">Performanță fără Supraveghere</p>
            </div>
        </div>
    </div>
</HealthAI>

    <Nextcloud
        title="Nextcloud:"
        highlight="Biroul tău Privat"
        description="Alternativa completă la Google Cloud/Drive. Documente, Calendar și Contacte sincronizate pe toate dispozitivele tale, fără ca o corporație să aibă acces la ele."
        features={["Sincronizare automată pe toate dispozitivele",
        "Colaborare în timp real",
        "Calendar și contacte private",
        "Backup automat"]}
    >
        <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/20 to-blue-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Înlocuiește:</p>
            <div class="space-y-3 mb-6">
				<p class="text-gray-300 line-through opacity-50">Google Drive & Photos</p>
				<p class="text-gray-300 line-through opacity-50">Microsoft Office 365</p>
				<p class="text-gray-300 line-through opacity-50">Dropbox & Box</p>
				<p class="text-gray-300 line-through opacity-50">Evernote & Slack</p>
				<p class="text-gray-300 line-through opacity-50">iCloud / Apple One</p>
			</div>
            <p class="text-gradient-sovereign font-bold text-lg">Cu o singură soluție</p>
        </div>
    </div>
    </Nextcloud>

<section class="py-24 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-red-500/10 blur-[120px] rounded-full -z-10"></div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">Marea <span class="text-red-500">Curățenie</span></h2>
            <p class="text-subtitle max-w-2xl mx-auto">
                Sovereign Life OS nu este o altă taxă. Este unealta care le elimină pe toate celelalte.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {[
                "Netflix", "Spotify", "iCloud", "Google One",
                "YNAB", "Strava", "Dropbox", "Evernote",
                "Zapier", "Notion", "LastPass", "MyFitnessPal",
                "Amazon Alexa", "Life360", "Microsoft 365", "Audible",
                "Disney+", "Zoom", "Slack", "WeTransfer Pro", // WeTransfer e foarte cunoscut
                "OneDrive", "Apple Music", "HBO Max", "Bitwarden Cloud"
            ].map((service) => (
                <div class="group relative bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-center transition-all duration-500 hover:bg-red-500/10 hover:border-red-500/30">
                    <span class="text-gray-500 font-medium group-hover:text-red-400 transition-colors">
                        {service}
                    </span>
                    <div class="absolute w-0 h-[2px] bg-red-500 left-0 top-1/2 -translate-y-1/2 transition-all duration-500 group-hover:w-full opacity-0 group-hover:opacity-100 shadow-[0_0_10px_rgba(239,68,68,0.5)]"></div>
                </div>
            ))}
        </div>

        <div class="mt-16 p-8 bg-gradient-to-r from-red-500/10 to-transparent border-l-4 border-red-500 rounded-r-2xl">
            <p class="text-white text-xl md:text-2xl font-light italic">
                "Am calculat că un utilizator mediu economisește între <span class="text-red-400 font-bold">1.200€ și 2.500€ pe an</span> prin simpla consolidare a acestor servicii în propriul sistem."
            </p>
        </div>
    </div>
</section>

<FAQ>
        <div slot="title">
            <h2 class="text-3xl md:text-5xl font-bold mb-4">Întrebări <span class="text-gradient-sovereign">Frecvente</span></h2>
            <p class="text-subtitle">Tot ce trebuie să știi despre noua ta suveranitate digitală.</p>
        </div>

        <FAQItem
            colorClass="emerald"
            question="Unde sunt stocate fizic datele mele?"
            answer="Pe un server (Mini PC sau NAS) situat în locuința ta. Nu există 'cloud' intermediar, servere în alte țări sau acces neautorizat. Tu deții hardware-ul, tu deții datele."
        />

        <FAQItem
            colorClass="blue"
            question="Ce se întâmplă dacă pică internetul?"
            answer="Sistemul funcționează perfect local. Poți controla casa, viziona filmele din librărie sau accesa documentele. Suveranitatea înseamnă că nu depinzi de o conexiune externă pentru funcțiile de bază."
        />

        <FAQItem
            colorClass="red"
            question="Dacă se strică hard-disk-ul sau se fură serverul?"
            answer="Sistemul folosește criptare AES-256 (fără cheia ta, datele sunt ilizibile) și o strategie de backup '3-2-1': datele sunt oglindite pe discuri redundante și salvate criptat într-o a doua locație."
        />

        <FAQItem
            colorClass="orange"
            question="AI-ul local este la fel de deștept ca ChatGPT?"
            answer="Folosim modele de limbaj (LLM) de ultimă generație optimizate pentru hardware-ul tău. Sunt extrem de capabile în sarcini de analiză financiară, nutriție și automatizare, totul cu latență zero și intimitate totală."
        />

        <FAQItem
            colorClass="purple"
            question="Pot accesa datele când nu sunt acasă?"
            answer="Da. Folosim tehnologii precum Tailscale pentru a crea un buncăr digital privat între dispozitivele tale. Te conectezi la serverul de acasă de oriunde în lume sigur și rapid, fără a expune datele pe internetul public."
        />

        <FAQItem
            colorClass="yellow"
            question="Pot să import datele vechi din Google sau Apple?"
            answer="Da. Sistemul include unelte de migrare pentru Google Photos, Drive și iCloud. Îți poți transfera întreaga istorie digitală, apoi poți închide abonamentele fără să pierzi nimic."
        />

        <FAQItem
            colorClass="blue"
            question="Cât consumă acest server la factura de curent?"
            answer="Serverele noastre sunt ultra-eficiente, consumând în medie cât un bec LED (10-15W). Costul anual este neglijabil față de sutele de euro economisite prin eliminarea abonamentelor."
        />

        <FAQItem
            colorClass="emerald"
            question="Trebuie să fiu programator ca să îl folosesc?"
            answer="Deloc. Sovereign Life OS are o interfață vizuală intuitivă. Odată configurat, este un sistem 'set and forget'. Primești actualizări automate și totul se gestionează dintr-un tablou de bord simplu."
        />

        <FAQItem
            colorClass="purple"
            question="Este o investiție unică sau are costuri ascunse?"
            answer="Este o investiție unică în libertatea ta. Nu există taxe lunare sau funcții blocate în spatele unui paywall. Software-ul și datele îți aparțin pe viață."
        />

        <FAQItem
            colorClass="orange"
            question="Cum mă ajută pilonul Strategic (Finance) să produc bani?"
            answer="AI-ul analizează scurgerile de capital, optimizează dobânzile datoriilor și îți oferă strategii de investiții. Nu doar economisești banii de abonament, ci înveți să îți gestionezi averea mai eficient."
        />
    </FAQ>

<WaitlistForm slot="form-area" placeholder="your@email.com" buttonText="Rezervă Acces Prioritar" />

<CTA
    title="Gata să-ți iei viața înapoi?"
    subtitle="Alătură-te revoluției suveranității digitale astăzi."
    buttonText="Rezervă Acces Prioritar"
/>

    <Footer>
        <div slot="brand">
            <h3 class="text-white font-bold text-xl mb-4">Sovereign Life OS</h3>
            <p class="text-gray-400">Transformă-ți casa într-un ecosistem inteligent și privat.</p>
        </div>

        <div slot="links">
            <h4 class="text-white font-bold mb-4">Link-uri</h4>
            <ul class="text-gray-400 space-y-2">
                <li><a href="#" class="hover:text-emerald-400 transition-colors">Documentație</a></li>
                <li><a href="#" class="hover:text-emerald-400 transition-colors">GitHub</a></li>
                <li><a href="#" class="hover:text-emerald-400 transition-colors">Politică de Confidențialitate</a></li>
            </ul>
        </div>

        <div slot="privacy">
            <h4 class="text-white font-bold mb-4">Intimitate Totală</h4>
            <p class="text-gray-400 italic text-sm">Datele tale nu părăsesc niciodată rețeaua locală. Fără urmărire. Fără cloud. Fără compromisuri.</p>
        </div>

        <p slot="copyright">© 2026 Sovereign Life OS. Toate drepturile rezervate.</p>
    </Footer>
</Layout>
