---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import Pillars from '../components/Pillars.astro';
import Nextcloud from '../components/Nextcloud.astro';
import EcosystemGrid from '../components/EcosystemGrid.astro';
import FAQItem from '../components/FAQItem.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

// Putem defini datele în variabile aici sus pentru a păstra HTML-ul curat jos
const pillarData = [
  { icon: "🥗", title: "AI Kitchen & Nutrition", desc: "Notificări înainte de expirarea alimentelor și liste de cumpărături inteligente.", color: "emerald" },
  { icon: "🧠", title: "Sănătate & Claritate", desc: "AI-ul tău local acționează ca un jurnal privat de wellness și fitness.", color: "blue" },
  { icon: "🏠", title: "Home Assistant", desc: "Automatizări și control vocal procesate 100% în casa ta.", color: "cyan" }
];
---

<Layout title="Sovereign Life OS">
    <Header title="Sovereign Life OS" subtitle="Private. Local. Yours"/>

    <HeroSection
        titlePart1="Majordomul Digital"
        titlePart2="care nu te spionează"
        subtitle="Înlocuiește Google, Alexa și abonamentele scumpe cu un singur creier central, local."
    >
        <WaitlistForm slot="form-area" />
    </HeroSection>

    <SavingsCalculator />

    <Pillars
        title='Cei 3 Piloni de <span class="text-emerald-400">Inteligență</span>'
        subtitle="Trei agenți AI care lucrează local pentru a-ți simplifica viața"
        items={pillarData}
    />

    <Nextcloud
        title="Nextcloud:"
        highlight="Biroul tău Privat"
        description="Alternativa completă la Google Cloud/Drive. Documente, Calendar și Contacte sincronizate pe toate dispozitivele tale, fără ca o corporație să aibă acces la ele."
        features={["Sincronizare automată pe toate dispozitivele",
        "Colaborare în timp real",
        "Calendar și contacte private",
        "Backup automat"]}
    >
        <div slot="visual-element" class="flex-1 hidden md:block">
        <div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/20 to-blue-500/20 border border-white/20 rounded-xl p-8 text-center">
            <p class="text-white font-bold mb-4 text-lg">Înlocuiește:</p>
            <div class="space-y-3 mb-6">
				<p class="text-gray-300 line-through opacity-50">Google Drive & Photos</p>
				<p class="text-gray-300 line-through opacity-50">Microsoft Office 365</p>
				<p class="text-gray-300 line-through opacity-50">Dropbox & Box</p>
				<p class="text-gray-300 line-through opacity-50">Evernote & Slack</p>
				<p class="text-gray-300 line-through opacity-50">iCloud / Apple One</p>
			</div>
            <p class="text-emerald-400 font-bold text-lg">Cu o singură soluție</p>
        </div>
    </div>
    </Nextcloud>

    <EcosystemGrid />

    <section class="px-6 py-20">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-6">
            <FAQItem colorClass="emerald" question="Unde sunt datele?" answer="Pe hard-disk-ul din sufrageria ta. Punct." />
            <FAQItem colorClass="blue" question="Costă mult?" answer="Sistemul se plătește singur în 2 ani prin eliminarea abonamentelor." />
        </div>
    </section>

    <CTA />
    <Footer />
</Layout>
